# Server-side only. These are read by the Netlify function and by the local dev
# middleware in vite.config.mjs -- they are NOT prefixed with VITE_, so Vite never
# inlines them into the browser bundle. Do not add a VITE_ prefix to a secret.

NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=00000000000000000000000000000000

# Optional: map each answer onto a column by name. Without these the function
# falls back to filling select columns in declared order, which Notion does not
# guarantee -- set them for reliable placement.
NOTION_PROP_ARCHETYPE=Archetype
NOTION_PROP_OBJECTIVE=Objective
NOTION_PROP_RESOURCES=Resources
NOTION_PROP_TIMELINE=Timeline
NOTION_PROP_CONTACT=Contact
